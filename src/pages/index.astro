---
import Layout from "../layouts/Layout.astro";
import ScrollFilm from "../components/motion/ScrollFilm.astro";
import * as film from "../data/home-film";
---
<Layout
  title="Stallion Developments | New Homes in Muskoka & Ontario"
  description="Premium new homes in Bracebridge, Muskoka, Prince Edward County and Kitchener by a Tarion-registered Ontario builder. Explore communities or invest with us."
  path=""
  variant="film"
>
  <!-- The home, deconstructing as you scroll. Segment ids in data-seg come from src/data/home-film.ts -->
  <ScrollFilm
    sources={film.sources}
    timeline={film.timeline}
    preload={film.preload}
    overlay={film.overlay}
    marquee={film.marquee}
    loader="Stallion"
  >
    <section class="band-section hero-section is-active" id="top" data-seg="hero:0,hero:1" data-animation="hero">
      <div class="hero-inner">
        <span class="eyebrow">Ontario home builder &amp; developer</span>
        <h1 class="hero-heading">
          <span class="line"><span class="word">Crafted</span> <span class="word">homes</span> <span class="word">in</span></span>
          <span class="line"><span class="word">Ontario's</span> <span class="word">most</span></span>
          <span class="line"><span class="word">sought-after</span> <span class="word">places.</span></span>
        </h1>
        <p class="hero-tagline">From the Heart of Muskoka to Prince Edward County and Waterloo Region, Stallion Developments designs, builds and sells premium new homes, and invites qualified investors to build alongside us.</p>
        <div class="hero-ctas">
          <a class="btn btn-solid" href="./communities/">Explore communities</a>
          <a class="btn btn-ghost" href="./invest/">Invest with us</a>
        </div>
        <div class="badge-strip"><span>Tarion-registered builder</span><span>Engineer-led</span><span>In-house construction</span></div>
      </div>
    </section>

    <section class="band-section" data-seg="clip1:0.15,clip1:0.95" data-animation="slide-left">
      <div class="beat-copy">
        <span class="beat-index">1</span>
        <h2 class="beat-heading">Builder-led, not broker-led.</h2>
        <p class="beat-body">Our CEO is a licensed Professional Engineer (20+ years) and a Tarion-registered builder (10+ years). Every home comes with Tarion new home warranty coverage.</p>
      </div>
    </section>

    <section class="band-section" data-seg="clip2:0.1,clip2:0.95" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index">2</span>
        <h2 class="beat-heading">In-house construction.</h2>
        <p class="beat-body">Our own team builds our homes, with no third-party general contractor markup. Your money goes into the materials and the craftsmanship.</p>
      </div>
    </section>
    <!-- Cutaway: rise into the upper floor (generated, frames/bedroom) -->
    <section class="band-section interlude" data-seg="brfwd:0.7,brrev:0.4" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index beat-eyebrow">Inside</span>
        <h2 class="beat-heading">Natural light, in every room.</h2>
      </div>
    </section>

    <section class="band-section" data-seg="clip3:0.1,clip3:0.95" data-animation="clip-reveal">
      <div class="beat-copy">
        <span class="beat-index">3</span>
        <h2 class="beat-heading">Transparent from day one.</h2>
        <p class="beat-body">Clear specs, clear timelines and regular construction updates for buyers and investors alike.</p>
      </div>
    </section>
    <!-- Cutaways: front door → living room → kitchen → deck (generated, frames/living, kitchen, deck) -->
    <section class="band-section interlude" data-seg="lvfwd:0.7,ktfwd:0.35" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index beat-eyebrow">Inside</span>
        <h2 class="beat-heading">Open-concept living.</h2>
      </div>
    </section>

    <section class="band-section interlude" data-seg="ktfwd:0.7,dkfwd:0.35" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index beat-eyebrow">Inside</span>
        <h2 class="beat-heading">The open-concept kitchen.</h2>
      </div>
    </section>

    <section class="band-section interlude" data-seg="dkfwd:0.7,byrev:0.4" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index beat-eyebrow">Out back</span>
        <h2 class="beat-heading">Generous yards, made for Muskoka summers.</h2>
      </div>
    </section>

    <section class="band-section" data-seg="clip4:0.1,clip4:0.95" data-animation="slide-left">
      <div class="beat-copy">
        <span class="beat-index">4</span>
        <h2 class="beat-heading">Land we already own.</h2>
        <p class="beat-body">Our Ontario pipeline sits on land we acquired between 2021 and 2023, so we're not waiting on speculative deals.</p>
      </div>
    </section>

    <section class="band-section" data-seg="clip5:0.05,clip5:0.95" data-animation="rotate-in">
      <div class="beat-copy">
        <span class="beat-index">5</span>
        <h2 class="beat-heading">Designed for how Ontario lives now.</h2>
        <p class="beat-body">Open-concept plans, generous yards and natural light, for full-time living as well as weekends.</p>
      </div>
    </section>

    <section class="band-section stats-section" data-seg="clip6:0.12,end:1" data-animation="stagger-up">
      <div class="stats-hero">
        <span class="stats-figure">$<span class="stat-number" data-value="50" data-decimals="0">0</span>M+</span>
        <span class="stats-caption">development pipeline across Ontario</span><!-- CONFIRM: $50M figure, see copy doc 9.1 -->
      </div>
      <div class="stats-grid">
        <div class="stat"><span class="stat-number" data-value="4" data-decimals="0">0</span><span class="stat-suffix"></span><span class="stat-label">active communities</span></div>
        <div class="stat"><span class="stat-number" data-value="30" data-decimals="0">0</span><span class="stat-suffix">+</span><span class="stat-label">acres secured and owned</span></div>
        <div class="stat"><span class="stat-number" data-value="75" data-decimals="0">0</span><span class="stat-suffix">+</span><span class="stat-label">years of combined leadership experience</span></div>
      </div>
    </section>
  </ScrollFilm>

<!-- ——— Released page flow ——— -->
<main class="page-flow">
  <span class="flow-anchor" id="flow"></span>

  <!-- Brand statement -->
  <section class="section" id="about">
    <div class="wrap statement">
      <h2 class="reveal">A developer built by builders.</h2>
      <div class="reveal">
        <p>Most developers hire out the hard part. We don't. Stallion Developments is led by a licensed Professional Engineer and Tarion-registered builder, backed by a construction, design and sales team that has delivered $150M+ in projects in Canada and abroad. We control every stage in-house, from land and approvals to construction and sales. That means fewer hand-offs, tighter quality and homes built the way we'd build them for our own families.</p>
        <p class="accent">Every detail is decided by the people accountable for it.</p>
      </div>
    </div>
  </section>

  <!-- Featured community -->
  <section class="section no-top" id="featured">
    <div class="wrap">
      <article class="featured reveal">
        <div class="featured-media">
          <img src="./assets/img/maple-aerial.webp" alt="Aerial rendering of Maple Place semi-detached homes, Bracebridge Muskoka" loading="lazy" />
        </div>
        <div class="featured-body">
          <span class="status-label"><span class="dot"></span>Now selling · Bracebridge, Muskoka</span><!-- CONFIRM status -->
          <h2>Maple Place. Walk-to-downtown living in the Heart of Muskoka.</h2>
          <p class="featured-lede">Premium semi-detached homes on quiet Maple Street, Bracebridge. Minutes from the lake, the falls and Muskoka's Downtown.</p>
          <dl class="spec-list">
            <div><dt>Bedrooms</dt><dd>3</dd></div>
            <div><dt>Bathrooms</dt><dd>2.5</dd></div>
            <div><dt>Size</dt><dd>1,900 sq ft above ground</dd></div>
            <div><dt>Lot</dt><dd>33' x 108' with deep private yard</dd></div>
            <div><dt>Layout</dt><dd>Open-concept, 2 storeys</dd></div>
            <div><dt>Warranty</dt><dd>Tarion</dd></div>
          </dl>
          <div class="hero-ctas">
            <a class="btn btn-solid" href="./communities/maple-place-bracebridge/#register">Get floor plans &amp; pricing</a>
            <a class="btn btn-ghost" href="./communities/maple-place-bracebridge/">Explore Maple Place</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Communities grid -->
  <section class="section" id="communities">
    <div class="wrap">
      <div class="split-head">
        <div class="section-head reveal">
          <span class="eyebrow">Communities</span>
          <h2>Our communities</h2>
          <p>Four communities, each with a distinct character, and one standard of build quality.</p>
        </div>
        <a class="btn btn-ghost reveal" href="./communities/">All communities</a>
      </div>
      <div class="card-grid cols-4">
      <a class="community-card reveal" href="./communities/maple-place-bracebridge/" data-tags="muskoka selling">
        <div class="card-media"><img src="./assets/img/maple-exterior.webp" alt="Maple Place semi-detached home exterior, Bracebridge Muskoka" loading="lazy" /><span class="status-label"><span class="dot"></span>Now selling</span></div>
        <div class="card-body">
          <h3>Maple Place</h3>
          <p class="card-desc">Walk-to-downtown living in the Heart of Muskoka</p>
          <p class="card-meta">Semi-detached homes · Bracebridge</p>
          <span class="link-arrow">Register</span>
        </div>
      </a>
      <a class="community-card reveal" href="./communities/anglo-street-bracebridge/" data-tags="muskoka soon">
        <div class="card-media placeholder"><span class="ph-mark">AS</span><span class="ph-note">Renderings coming soon</span><span class="status-label soon"><span class="dot"></span>Coming soon</span></div>
        <div class="card-body">
          <h3>Anglo Street</h3>
          <p class="card-desc">The next chapter of Bracebridge</p>
          <p class="card-meta">Semi-detached homes · Bracebridge · 1 acre</p>
          <span class="link-arrow">Register interest</span>
        </div>
      </a>
      <a class="community-card reveal" href="./communities/chicopee-heights-kitchener/" data-tags="waterloo soon">
        <div class="card-media placeholder"><span class="ph-mark">CH</span><span class="ph-note">Renderings coming soon</span><span class="status-label soon"><span class="dot"></span>Coming soon</span></div>
        <div class="card-body">
          <h3>Chicopee Heights</h3>
          <p class="card-desc">Detached family homes in Waterloo Region</p>
          <p class="card-meta">Detached homes · Kitchener · 3 acres</p>
          <span class="link-arrow">Register interest</span>
        </div>
      </a>
      <a class="community-card reveal" href="./communities/lady-of-the-woods-prince-edward-county/" data-tags="pec soon">
        <div class="card-media placeholder"><span class="ph-mark">LW</span><span class="ph-note">Renderings coming soon</span><span class="status-label soon"><span class="dot"></span>Coming soon</span></div>
        <div class="card-body">
          <h3>Lady of the Woods Estate Homes</h3>
          <p class="card-desc">Estate living on 24 acres in Prince Edward County</p>
          <p class="card-meta">Estate homes · Prince Edward County</p>
          <span class="link-arrow">Register interest</span>
        </div>
      </a>
    </div>
    </div>
  </section>

  

  

  <!-- Final CTA -->
  <section class="section pine final-cta" id="register">
    <div class="wrap reveal">
      <h2>Find your place in Muskoka and beyond.</h2>
      <p>Register for floor plans, pricing and first access to new releases.</p>
      <div class="hero-ctas">
        <a class="btn btn-light btn-lg" href="./contact/?reason=Buying%20a%20home">Register now</a>
        <a class="btn btn-ghost btn-lg" href="./invest/">Invest with us</a>
      </div>
    </div>
  </section>

</main>
</Layout>
