---
import Layout from "../../layouts/Layout.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.stalliondevelopments.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Legal",
        "item": "https://www.stalliondevelopments.com/legal/"
      }
    ]
  }
];
---
<Layout
  title="Legal & Investor Disclaimer | Stallion Developments"
  description="Legal notices, rendering disclaimer and investor disclaimer for the Stallion Developments website."
  path="legal/"
  schema={schema}
>

<main class="page">
  <section class="page-hero">
    <div class="wrap">
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="../">Home</a><span>/</span>Legal</nav>
        <span class="eyebrow">Legal</span>
        <h1>Legal &amp; investor disclaimer</h1>
        <p class="lede">The notices that apply to everything on this website.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <h2>Website content</h2>
      <p>&copy; 2026 Stallion Developments. All rights reserved.<!-- CONFIRM: legal entity name --> Renderings are artist's concepts only and may not reflect final construction, finishes or landscaping. Prices, specifications and availability are subject to change without notice. E.&amp;O.E.</p>
      <h2>Investment information</h2>
      <p>Nothing on this website is an offer to sell, or a solicitation of an offer to buy, any security. Any such offer is made only to qualified investors through definitive offering documents in jurisdictions where permitted.</p>
      <p>Real estate investments involve substantial risk, including loss of capital, illiquidity, construction delays, cost overruns and market changes. Past performance does not guarantee future results. Interest rates and returns shown are targets or contractual terms and are not guaranteed. A second-mortgage position and conservative loan-to-value are designed to reduce risk, not eliminate it. Consult your own legal, tax and financial advisors before investing.</p>
      <p>Our offerings are available to accredited investors as defined under Canadian securities law (National Instrument 45-106), and to eligible investors in other jurisdictions where permitted.</p>
      <!-- CONFIRM: FSRA brokerage licence / EMD details; U.S. exemption language if marketing to U.S. persons -->
      <h2>New home warranty</h2>
      <p>Stallion Developments homes are built by a Tarion-registered builder and are covered by the Tarion new home warranty program.<!-- CONFIRM: registered entity + builder number --></p>
      <h2>Communications</h2>
      <p>By submitting a form on this website and checking the consent box, you agree to receive updates, floor plans and offers from Stallion Developments by email and phone. You can unsubscribe at any time using the link in any email or by writing to <a href="mailto:info@stalliondevelopments.com">info@stalliondevelopments.com</a>.</p>
    </div>
  </section>
</main>
</Layout>
