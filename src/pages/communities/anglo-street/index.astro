---
import Layout from "../../../layouts/Layout.astro";
import CommunityCards from "../../../components/CommunityCards.astro";
import InvestorBand from "../../../components/InvestorBand.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Residence",
    "name": "Anglo Street",
    "url": "https://www.stalliondevelopments.com/communities/anglo-street/",
    "description": "Semi-detached homes on a 1-acre site on Anglo Street, Bracebridge, from the builder of Maple Place.",
    "address": { "@type": "PostalAddress", "addressLocality": "Bracebridge", "addressRegion": "ON", "addressCountry": "CA" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.stalliondevelopments.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Communities",
        "item": "https://www.stalliondevelopments.com/communities/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Anglo Street",
        "item": "https://www.stalliondevelopments.com/communities/anglo-street/"
      }
    ]
  }
];
---
<Layout
  title="New Semi-Detached Homes Coming to Bracebridge | Anglo Street"
  description="A new community of semi-detached homes on a 1-acre site on Anglo Street, Bracebridge, by the builder of Maple Place. Join the waitlist."
  path="communities/anglo-street/"
  current="communities"
  schema={schema}
>

<main class="page">
  <section class="page-hero has-media">
    <div class="wrap">
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="../../">Home</a><span>/</span><a href="../../communities/">Communities</a><span>/</span>Anglo Street</nav>
        <span class="status-label soon"><span class="dot"></span>Delivering Q4 2028 · Bracebridge, Muskoka</span>
        <h1>Coming soon: new semi-detached homes on Anglo Street, Bracebridge.</h1>
        <p class="lede">Anglo Street is Stallion's second Bracebridge community: a small collection of semi-detached homes on a 1-acre site, from the builder of Maple Place. Plans are underway, with the first homes expected to be delivered in Q4 2028. Join the waitlist for first access to floor plans, pricing and the sales launch date.</p>
        <div class="chips"><span class="chip">Semi-detached homes</span><span class="chip">1-acre site</span><span class="chip">Bracebridge, Muskoka</span></div><!-- CONFIRM: home count and release timing -->
        <div class="hero-ctas"><a class="btn btn-solid" href="#register">Join the waitlist</a></div>
      </div>
      <div class="hero-media reveal"><div class="card-media placeholder" style="aspect-ratio:1;border-radius:18px"><span class="ph-mark">AS</span></div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">Why Bracebridge</span><h2>The Heart of Muskoka</h2></div>
      <div class="statement reveal"><p class="lede" style="grid-column:1/-1;color:var(--ink-soft)">Bracebridge, known as the Heart of Muskoka, is the seat of the District government. It has 17,305 permanent residents and a growing year-round community, and Muskoka's growth strategy anticipates 16,150 new permanent housing units between 2021 and 2051. It's about 2 hours 15 minutes north of Toronto.</p></div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap trust">
      <div class="reveal">
        <span class="eyebrow">Built by Stallion</span>
        <h2>Built by the team that designs it</h2>
        <p>Every Stallion community is built by our in-house construction team, led by a licensed Professional Engineer and Tarion-registered builder, on land we already own. Fixed-price contracts with trusted trades and schedule buffers for Ontario winters mean the home you're promised is the home you get.</p>
      </div>
      <div class="badges reveal">
        <div class="badge">Tarion new home warranty</div>
        <div class="badge">Engineer-led</div>
        <div class="badge">In-house construction</div>
        <div class="badge">Land owned</div>
      </div>
    </div>
  </section>

  <section class="section" id="register">
    <div class="wrap form-layout">
      <div class="sticky reveal">
        <span class="eyebrow">Register</span>
        <h2 class="h2" style="margin-top:0.8rem">Join the waitlist</h2>
        <p class="ink-soft" style="margin-top:1rem;font-size:1.08rem">Registrants get first access to floor plans, pricing and lot selection before the public release.</p>
      </div>
      <div>
        <form class="form reveal" method="post" data-endpoint="" data-form="anglo-street-register" data-form-type="floor_plan">
          <input type="hidden" name="community" value="Anglo Street" />
          <div class="row"><div class="field"><label for="first_name">First name*</label><input id="first_name" name="first_name" type="text" required placeholder="" /></div><div class="field"><label for="last_name">Last name*</label><input id="last_name" name="last_name" type="text" required placeholder="" /></div></div>
          <div class="row"><div class="field"><label for="email">Email*</label><input id="email" name="email" type="email" required placeholder="" /></div><div class="field"><label for="phone">Phone*</label><input id="phone" name="phone" type="tel" required placeholder="" /></div></div>
          <div class="row"><div class="field"><label for="postal_code">Postal code*</label><input id="postal_code" name="postal_code" type="text" required placeholder="" /></div><div class="field"><label for="purpose">This home would be my…</label><select id="purpose" name="purpose"><option value="" disabled selected>Select…</option><option value="Primary residence">Primary residence</option><option value="Weekend or seasonal home">Weekend or seasonal home</option><option value="Investment property">Investment property</option><option value="Downsizing">Downsizing</option></select></div></div>
          <div class="row"><div class="field"><label for="timeline">When do you plan to move?*</label><select id="timeline" name="timeline" required><option value="" disabled selected>Select…</option><option value="0–3 months">0–3 months</option><option value="3–6 months">3–6 months</option><option value="6–12 months">6–12 months</option><option value="12+ months">12+ months</option></select></div><div class="field"><label for="budget">Budget</label><select id="budget" name="budget"><option value="" disabled selected>Select…</option><option value="Under $800K">Under $800K</option><option value="$800K–$1M">$800K–$1M</option><option value="$1M–$1.5M">$1M–$1.5M</option><option value="$1.5M+">$1.5M+</option></select></div></div>
          <label class="check"><input type="checkbox" name="agent" value="yes" /> <span>I am a real estate agent</span></label>
          <div class="field"><label for="questions">Questions</label><textarea id="questions" name="questions" placeholder="Anything you'd like to know?"></textarea></div>
          <label class="check"><input type="checkbox" name="consent" value="yes" required /> <span>Yes, I'd like to receive updates, floor plans and offers from Stallion Developments by email and phone. I can unsubscribe at any time.</span></label>
          <button class="btn btn-solid btn-lg" type="submit">Join the waitlist</button>
          <p class="micro recaptcha-note">This site is protected by reCAPTCHA and the Google <a href="https://policies.google.com/privacy">Privacy Policy</a> and <a href="https://policies.google.com/terms">Terms of Service</a> apply.</p>
        </form>
        <div class="form-success"><h3>You're on the list.</h3><p>We'll send you the release package for Anglo Street as soon as it's ready, and a member of our sales team will be in touch within one business day.</p></div>
      </div>
    </div>
  </section>

  <InvestorBand />

  <section class="section no-top">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">Other communities</span><h2>More from Stallion</h2></div>
      <CommunityCards exclude="anglo-street" />
      <p class="disclaimer" style="margin-top:2.5rem">Renderings are artist's concepts only and may not reflect final construction details, finishes or landscaping. Specifications, pricing and availability are subject to change without notice. E.&amp;O.E.</p>
    </div>
  </section>
</main>
</Layout>
