---
import Layout from "../../layouts/Layout.astro";
import CommunityCards from "../../components/CommunityCards.astro";
import InvestorBand from "../../components/InvestorBand.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.stalliondevelopments.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Communities",
        "item": "https://www.stalliondevelopments.com/communities/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Where does Stallion Developments build?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Stallion Developments builds premium new homes in Ontario. Current communities are in Bracebridge (Muskoka), Kitchener and Prince Edward County."
        }
      },
      {
        "@type": "Question",
        "name": "Is Stallion Developments a Tarion-registered builder?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Every Stallion home is enrolled with Tarion and comes with Ontario's statutory new home warranty."
        }
      },
      {
        "@type": "Question",
        "name": "Are there new homes for sale in Bracebridge right now?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Maple Place is a boutique collection of semi-detached homes on Maple Street in Bracebridge. Each has about 1,900 sq ft above ground, 3 bedrooms, 2.5 bathrooms and a finished lower level with its own entrance. Register to receive floor plans and pricing."
        }
      },
      {
        "@type": "Question",
        "name": "Can I invest in Stallion's developments?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Stallion partners with a small group of accredited investors on select projects, through loans secured by a registered mortgage. Visit Investors to start a confidential conversation."
        }
      }
    ]
  }
];
---
<Layout
  title="New Home Communities in Ontario | Stallion Developments"
  description="Explore new homes by Stallion Developments in Bracebridge, Muskoka, Kitchener and Prince Edward County. Register for floor plans, pricing and first access."
  path="communities/"
  current="communities"
  schema={schema}
>

<main class="page">
  <section class="page-hero has-loop">
    <div class="hero-loop" aria-hidden="true">
      <img src="../assets/loops/communities.webp" alt="" loading="eager" />
      <video autoplay muted loop playsinline preload="metadata" poster="../assets/loops/communities.webp"><source src="../assets/loops/communities.mp4" type="video/mp4" /></video>
    </div>
    <div class="wrap">
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="../">Home</a><span>/</span>Communities</nav>
        <span class="eyebrow">Communities</span>
        <h1>New home communities across Ontario</h1>
        <p class="lede">Boutique collections in places people fall in love with. Filter by region or register for first access to every release.</p>
        <div class="hero-ctas"><a class="btn btn-solid" href="../register/">Register for first access</a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter communities">
        <button class="filter active" data-filter="all">All</button>
        <button class="filter" data-filter="muskoka">Muskoka</button>
        <button class="filter" data-filter="kitchener">Kitchener</button>
        <button class="filter" data-filter="pec">Prince Edward County</button>
        <button class="filter" data-filter="selling">Now Selling</button>
        <button class="filter" data-filter="soon">Coming Soon</button>
      </div>
      <CommunityCards cols={2} />
    </div>
  </section>

  <!-- Why we build where we build -->
  <section class="section" id="regions">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Where we build</span>
        <h2>Why we build where we build</h2>
      </div>
      <div class="why-grid">
        <div class="why-card reveal"><span class="eyebrow">Why Muskoka</span><h3>The Heart of Muskoka</h3><p>Bracebridge, known as the Heart of Muskoka, is the seat of the District government. It has 17,305 permanent residents and a growing year-round community. It's also about 2 hours 15 minutes north of Toronto.</p></div>
        <div class="why-card reveal"><span class="eyebrow">Why Prince Edward County</span><h3>Wine and beach country</h3><p>It's Ontario's wine and beach country, where limited supply meets growing demand for estate-scale living.</p></div>
        <div class="why-card reveal"><span class="eyebrow">Why Kitchener</span><h3>A tech and education hub</h3><p>It's one of Canada's leading tech and education hubs, with steady demand for well-built detached family homes.</p></div>
      </div>
    </div>
  </section>

  <!-- Construction updates -->
  <section class="section" id="updates">
    <div class="wrap">
      <div class="split-head">
        <div class="section-head reveal">
          <span class="eyebrow">Construction updates</span>
          <h2>Construction updates</h2>
          <p>Follow progress, milestones and timelines across our communities.</p>
        </div>
        <a class="btn btn-ghost reveal" href="../register/">Get updates by email</a>
      </div>
      <div class="card-grid cols-3">
        <article class="update-card reveal"><span class="meta">Maple Place · July 2025</span><h3>Construction underway on Maple Street</h3><p>Site work began on the semi-detached homes at 243–249 Maple Street with permits approved and land owned outright.</p><a class="link-arrow" href="../communities/maple-place/#timeline">Read update</a></article>
        <article class="update-card reveal"><span class="meta">Maple Place · Pre-construction</span><h3>Pre-construction sales now open</h3><p>Floor plans and pricing for the four homes are being released to registrants. Register for the full package and first access.</p><a class="link-arrow" href="../communities/maple-place/#register">Register</a></article>
        <article class="update-card reveal"><span class="meta">Pipeline · 2021–2023</span><h3>Land secured across three regions</h3><p>Sites in Bracebridge, Kitchener and Prince Edward County acquired and owned, forming the $50M Ontario pipeline.</p><a class="link-arrow" href="../communities/">See the communities</a></article>
      </div>
    </div>
  </section>

<section class="section" id="faq">
    <div class="wrap-narrow">
      <div class="section-head reveal"><h2>Frequently asked questions</h2></div>
      <div class="faq reveal">
      <details>
        <summary>Where does Stallion Developments build?</summary>
        <div class="answer"><p>Stallion Developments builds premium new homes in Ontario. Current communities are in Bracebridge (Muskoka), Kitchener and Prince Edward County.</p></div>
      </details>
      <details>
        <summary>Is Stallion Developments a Tarion-registered builder?</summary>
        <div class="answer"><p>Yes. Every Stallion home is enrolled with Tarion and comes with Ontario's statutory new home warranty.</p></div>
      </details>
      <details>
        <summary>Are there new homes for sale in Bracebridge right now?</summary>
        <div class="answer"><p>Yes. Maple Place is a boutique collection of semi-detached homes on Maple Street in Bracebridge. Each has about 1,900 sq ft above ground, 3 bedrooms, 2.5 bathrooms and a finished lower level with its own entrance. <a href="../communities/maple-place/#register">Register</a> to receive floor plans and pricing.</p></div>
      </details>
      <details>
        <summary>Can I invest in Stallion's developments?</summary>
        <div class="answer"><p>Stallion partners with a small group of accredited investors on select projects, through loans secured by a registered mortgage. Visit <a href="../investors/">Investors</a> to start a confidential conversation.</p></div>
      </details>
      </div>
    </div>
  </section>

  <InvestorBand />

  <section class="section pine final-cta">
    <div class="wrap reveal">
      <h2>Find your place in Muskoka.</h2>
      <p>Register for floor plans, pricing and first access to new releases.</p>
      <div class="hero-ctas"><a class="btn btn-light btn-lg" href="../register/">Register now</a></div>
    </div>
  </section>
</main>
</Layout>
