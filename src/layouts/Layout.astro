---
/* Shared page shell: head tags, header, footer and site-wide scripts.
   Page content goes in the default slot; anything extra for <head> goes in slot="head". */
import "../styles/style.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url, absolute, SITE_URL } from "../lib/url";

interface Props {
  title: string;
  description: string;
  /** Path on the production domain, e.g. "communities/" ("" for home) */
  path: string;
  /** Nav item to mark as the current page */
  current?: "communities" | "why" | "team" | "investors" | "blog" | "contact";
  ogImage?: string;
  /** "article" for blog posts */
  ogType?: "website" | "article";
  /** Extra JSON-LD objects (breadcrumbs, FAQ, people…); the Organization block is always included */
  schema?: object[];
  /** "inner" for regular pages; "film" for a page led by a ScrollFilm (transparent header, no CSS smooth scroll) */
  variant?: "inner" | "film";
}

const { title, description, path, current, ogImage = "assets/img/maple-exterior.webp", ogType = "website", schema = [], variant = "inner" } = Astro.props;
const canonical = absolute(path);

// Every page (client copy doc, "Structured data"). logo and sameAs are left out until
// there is a logo file and the LinkedIn / Google Business Profile URLs exist.
const ORGANIZATION = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${SITE_URL}/#org`,
  name: "Stallion Developments",
  url: `${SITE_URL}/`,
  email: "info@stalliondevelopments.com",
  description: "Engineer-led, Tarion-registered Ontario home builder building new homes in Bracebridge, Kitchener and Prince Edward County.",
  address: { "@type": "PostalAddress", streetAddress: "243 Maple Street", addressLocality: "Bracebridge", addressRegion: "ON", addressCountry: "CA" },
  areaServed: ["Bracebridge", "Muskoka", "Kitchener", "Prince Edward County"],
};
// Google Tag Manager container; GA4 (G-5FQENJ8PYL) and the form key events are configured inside GTM.
// Leave empty and no tracking loads.
const GTM_ID = "GTM-T5G86S33";
const FAVICON = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232e4b34'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='Georgia,serif' font-size='20' fill='%23f2efe7'%3ES%3C/text%3E%3C/svg%3E";
---
<!DOCTYPE html>
<html lang="en" class={variant === "inner" ? "inner" : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {GTM_ID && <script define:vars={{ GTM_ID }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
    var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
    j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',GTM_ID);
  </script>}
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absolute(ogImage)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <link rel="icon" href={FAVICON} />
  {[ORGANIZATION, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <slot name="head" />
</head>
<body class={variant}>
  {GTM_ID && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
  <Header current={current} />
  <slot />
  <Footer />
  <!-- public/js/config.js holds the form endpoint and reCAPTCHA key; it stays a plain, unbundled file so it is easy to find and edit -->
  <script is:inline src={url("js/config.js")}></script>
  <script>import "../scripts/site.js";</script>
</body>
</html>
