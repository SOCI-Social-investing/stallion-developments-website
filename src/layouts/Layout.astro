---
/* Shared page shell: head tags, header, footer and site-wide scripts.
   Page content goes in the default slot; anything extra for <head> goes in slot="head". */
import "../styles/style.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url, absolute, SITE_URL } from "../lib/url";

interface Props {
  title: string;
  description: string;
  /** Path on the production domain, e.g. "communities/" ("" for home) */
  path: string;
  /** Nav item to mark as the current page */
  current?: "communities" | "invest" | "team" | "contact";
  ogImage?: string;
  /** Extra JSON-LD objects (breadcrumbs, FAQ, people…); the Organization block is always included */
  schema?: object[];
  /** "inner" for regular pages; "film" for a page led by a ScrollFilm (transparent header, no CSS smooth scroll) */
  variant?: "inner" | "film";
}

const { title, description, path, current, ogImage = "assets/img/maple-exterior.webp", schema = [], variant = "inner" } = Astro.props;
const canonical = absolute(path);

const ORGANIZATION = {
  "@context": "https://schema.org",
  "@type": ["Organization", "HomeAndConstructionBusiness"],
  name: "Stallion Developments",
  url: SITE_URL,
  email: "info@stalliondevelopments.com",
  description: "Premium new homes and development opportunities across Ontario, from the Heart of Muskoka to Prince Edward County and Waterloo Region.",
  areaServed: [
    { "@type": "Place", name: "Bracebridge, Ontario" },
    { "@type": "Place", name: "Muskoka, Ontario" },
    { "@type": "Place", name: "Kitchener, Ontario" },
    { "@type": "Place", name: "Prince Edward County, Ontario" },
  ],
  slogan: "Built with intent.",
};
const FAVICON = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232e4b34'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='Georgia,serif' font-size='20' fill='%23f2efe7'%3ES%3C/text%3E%3C/svg%3E";
---
<!DOCTYPE html>
<html lang="en" class={variant === "inner" ? "inner" : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absolute(ogImage)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <link rel="icon" href={FAVICON} />
  {[ORGANIZATION, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <slot name="head" />
</head>
<body class={variant}>
  <Header current={current} />
  <slot />
  <Footer />
  <!-- public/js/config.js holds the form endpoint and reCAPTCHA key; it stays a plain, unbundled file so it is easy to find and edit -->
  <script is:inline src={url("js/config.js")}></script>
  <script>import "../scripts/site.js";</script>
</body>
</html>
