---
import { url } from "../lib/url";
import { communities } from "../data/communities";
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={url()}>Stallion<em>Developments</em></a>
        <p>New homes in Bracebridge, Muskoka, Kitchener and Prince Edward County, designed and built by an engineer-led Ontario team. Tarion-registered builder.</p>
        <p class="tagline">Built with intent.</p>
      </div>
      <div class="footer-col">
        <h3>Communities</h3>
        <ul>
          {communities.map((c) => <li><a href={url(`communities/${c.slug}/`)}>{c.name}, {c.town.replace(", Muskoka", "")}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href={url("team/")}>Our Team</a></li>
          <li><a href={url("investors/")}>Investors</a></li>
          <li><a href={url("blog/")}>Blog</a></li>
          <li><a href={url("register/")}>Register / Contact</a></li>
          <li><a href={url("legal/")}>Legal</a></li>
          <li><a href="mailto:info@stalliondevelopments.com">info@stalliondevelopments.com</a></li>
          <!-- CONFIRM: sales phone number -->
        </ul>
      </div>
      <div class="footer-col footer-news">
        <h3>Be first to know</h3>
        <p>Be first to hear about new homes. Floor plans, pricing and release dates, a few times a year. No spam.</p>
        <form class="news-form" novalidate="false">
          <label class="visually-hidden" for="news-email">Email</label>
          <input id="news-email" type="email" name="email" placeholder="Email address" required />
          <button class="btn btn-solid btn-sm" type="submit">Subscribe</button>
        </form>
        <div class="form-success" style="margin-top:0.8rem;padding:0.9rem 1rem"><p>You're on the list.</p></div>
      </div>
    </div>
    <div class="footer-legal">
      <p>&copy; 2026 Stallion Developments. All rights reserved.<!-- CONFIRM: legal entity name --> Renderings are artist's concepts and may not show final construction, finishes or landscaping. Prices, specifications and availability may change without notice. E.&amp;O.E.</p>
      <p>Nothing on this website is an offer to sell, or a request for an offer to buy, any security or mortgage investment. Any such offer is made only to eligible investors through definitive offering documents. <a href={url("legal/")}>Legal &amp; investor disclaimer</a><!-- CONFIRM: counsel to approve this wording (syndicated mortgage rules) --></p>
    </div>
  </div>
</footer>
