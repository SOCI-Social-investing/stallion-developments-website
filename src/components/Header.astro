---
import { url } from "../lib/url";

interface Props {
  /** Nav item marked aria-current="page" */
  current?: "communities" | "why" | "team" | "investors" | "contact";
}
const { current } = Astro.props;

// Buyers first; investors get a quieter link (client copy doc, 2026-09-29).
// "Why Stallion" points at the homepage section until it has its own page.
const NAV = [
  { key: "communities", href: "communities/", label: "Communities" },
  { key: "why", href: "#why-stallion", label: "Why Stallion" },
  { key: "team", href: "team/", label: "Our Team" },
  { key: "investors", href: "investors/", label: "Investors" },
  { key: "contact", href: "register/", label: "Contact" },
];
const register = url("register/");
---
<header class="site-header">
  <a class="brand" href={url()}>Stallion<em>Developments</em></a>
  <nav class="site-nav" id="site-nav" aria-label="Primary">
    {NAV.map((item) => (
      <a href={url(item.href)} aria-current={item.key === current ? "page" : undefined}>{item.label}</a>
    ))}
    <a class="header-cta" href={register}>Register now</a>
  </nav>
  <div class="header-right">
    <a class="header-cta" href={register}>Register now</a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span></span></button>
  </div>
</header>
