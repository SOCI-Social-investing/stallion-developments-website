---
/* The investor band on community pages. Per the client's copy doc: no public
   numbers and no mortgage position (the offering documents state it). */
import { url } from "../lib/url";
---
<section class="section">
  <div class="wrap">
    <div class="band-cta reveal">
      <div>
        <span class="eyebrow">For investors</span>
        <h2>Build alongside the builders.</h2>
        <p>Stallion partners with a small group of accredited investors on select residential projects in Ontario. Terms are shared privately with eligible investors.</p>
        <div class="chips"><span class="chip">Secured by real property</span><span class="chip">Our money goes in first</span><span class="chip">Monthly reporting</span></div>
      </div>
      <aside>
        <a class="btn btn-light btn-lg" href={url("investors/")}>Learn how we partner</a>
        <p class="micro">For accredited investors only. All investments carry risk.</p>
      </aside>
    </div>
  </div>
</section>
